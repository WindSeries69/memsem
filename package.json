{
  "name": "memsem",
  "version": "1.3.0",
  "type": "module",
  "description": "Mémoire sémantique persistante et priorisée pour IA (serveur MCP universel)",
  "keywords": [
    "mcp",
    "memory",
    "semantic-memory",
    "ai",
    "claude",
    "opencode",
    "persistent-memory",
    "memory-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WindSeries69/memsem.git"
  },
  "homepage": "https://github.com/WindSeries69/memsem",
  "bugs": {
    "url": "https://github.com/WindSeries69/memsem/issues"
  },
  "bin": {
    "memsem": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "opencode-plugin",
    "assets",
    "scripts",
    "README.md",
    "README.fr.md",
    "memory-protocol.md"
  ],
  "scripts": {
    "build": "tsc && cp src/plugin.ts opencode-plugin/memsem-extract.ts",
    "start": "node dist/index.js",
  "test": "npm run build && node dist/test/client-test.js && node dist/test/durability-test.js && node dist/test/config-test.js && node dist/test/score-test.js && node dist/test/cli-test.js && node dist/test/regression-test.js && node dist/test/governance-test.js && node scripts/bench.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.8.0"
  }
}
